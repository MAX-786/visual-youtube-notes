# Copy to deploy/.env on the host and fill in every value. Nothing here is a
# secret: secrets are files under deploy/secrets/ (ADR 0008). The pins the
# images were built with live in versions.env and are only needed by a local
# `docker compose --env-file .env --env-file versions.env build`; the host
# pulls images CI built and never builds.

# The image tag to run: what the "Build images" workflow printed for the
# commit you are deploying, e.g. 2026.09.07-1b816e9b. Rollback is changing
# this to the previous tag and running `docker compose pull && up -d`.
APP_VERSION=

# Must match the `github.com/riverqueue/river` line in backend/go.mod. Only
# read by a local build; CI derives it from go.mod.
RIVER_VERSION=0.47.0

# The off-server restic repository: an SFTP URL to your laptop, e.g.
# sftp:backup@laptop.example:/srv/vyn-restic. Leave empty to run without an
# off-server copy (the sidecar warns at every start; spec 12 asks for one).
RESTIC_SFTP_REPO=

# The PUBLIC half of the age recovery identity created on your laptop with
# `age-keygen -o vyn-recovery.txt`: the line starting age1... The private
# identity stays in your password manager and is never on this host. The
# backup sidecar refuses to start without this.
BACKUP_RECOVERY_RECIPIENT=
