# Pinned external binaries and their checksums, the single source both CI
# (.github/workflows/build.yml) and a local `docker compose build` read.
# Every Dockerfile refuses to build without both halves of a pin, so a bumped
# version with a stale checksum fails the build instead of fetching whatever
# the tag points at today (ADR 0008). Checksums come from each release's own
# checksum asset, or from the downloaded artifact where a project publishes
# none; the build verifies them again on every run.
#
# Images build for linux/amd64 and linux/arm64 (the OCI host is an Ampere
# A1), so each binary carries one checksum per architecture and the
# Dockerfile picks by TARGETARCH.
#
# Bumping yt-dlp: the CalVer travels as a second worker image tag, so a
# rollback is a tag change. Bump DENO_VERSION in the same change when yt-dlp's
# JavaScript runtime requirement moves (docs/ops/runbook.md).

# yt-dlp release 2026.08.19, assets yt-dlp_linux and yt-dlp_linux_aarch64 (SHA2-256SUMS)
YTDLP_VERSION=2026.08.19
YTDLP_SHA256_AMD64=58162f9bfdc27458ea47bfcb311cf47028f17d8154a8bf7d689861d46399230a
YTDLP_SHA256_ARM64=b16e4dab368a816cd05d477d698a605a6ae87ccee1c8ffd38fa21d7254141fcc

# Deno v2.9.6, assets deno-x86_64-unknown-linux-gnu.zip and deno-aarch64-unknown-linux-gnu.zip (.sha256sum)
DENO_VERSION=2.9.6
DENO_SHA256_AMD64=394f07f4da2bebe6ce6f1e7ce0fa16429b29b08c35e3fac3fe25972676dff4b2
DENO_SHA256_ARM64=9a46afc6c392c7cd2ff71a31558935545b46408d0e87f7a86908c712721c046e

# restic v0.19.1, assets restic_0.19.1_linux_amd64.bz2 and restic_0.19.1_linux_arm64.bz2 (SHA256SUMS)
RESTIC_VERSION=0.19.1
RESTIC_SHA256_AMD64=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c
RESTIC_SHA256_ARM64=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465

# age v1.3.2, assets age-v1.3.2-linux-amd64.tar.gz and age-v1.3.2-linux-arm64.tar.gz (no upstream sums; taken from the artifacts)
AGE_VERSION=1.3.2
AGE_SHA256_AMD64=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
AGE_SHA256_ARM64=6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4

# supercronic v0.2.49, assets supercronic-linux-amd64 and supercronic-linux-arm64 (no upstream sha256; taken from the artifacts)
SUPERCRONIC_VERSION=0.2.49
SUPERCRONIC_SHA256_AMD64=a53ae236602c7338aba3fbaff40bda6300eae3b9fedb8261eb06cfe3724430c1
SUPERCRONIC_SHA256_ARM64=02aa0cb229ba09050cba6638059dadb9eedc2276632ea43d6a57a2f8c1629dd5
