        "canonical_url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
        "title": "How spaced repetition actually works",
        "channel": "Study Lab",
        "duration_seconds": 1873,
        "published_at": "2026-07-19"
      },
      "transcript": {
        "id": "2e4f6a80-3b5c-4d1e-9f70-8a2b4c6d8e01",
        "source_kind": "caption_human",
        "language_code": "en",
        "normalized_text": "Most people revise by rereading, which feels fluent and teaches very little. Spacing the same total minutes across several days forces retrieval, and it is the effort of retrieving that consolidates the memory.",
        "created_at": "2026-08-02T09:13:20Z"
      },
      "takeaway": {
        "text": "Try this on the statistics deck: one review tomorrow, one next Sunday.",
        "updated_at": "2026-08-14T20:31:09Z"
      },
      "revisions": [
        {
          "id": "a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
          "revision_number": 1,
          "origin": "generated",
          "parent_revision_id": null,
          "generated_from_transcript_id": "2e4f6a80-3b5c-4d1e-9f70-8a2b4c6d8e01",
          "generation_instruction": null,
          "payload": {
            "schema_version": 1,
            "detected_language": "en",
            "primary_topic": "Learning techniques",
            "tags": ["memory", "study habits"],
            "summary": {
              "id": "s1",
              "text": "Spacing reviews over days beats one long session for durable recall.",
              "provenance": "ai",
              "source_refs": [
                {
                  "chunk_id": "c1",
                  "start": 0,
                  "end": 64,
                  "quote": "spaced repetition"
                }
              ]
            },
            "key_points": [
              {
                "id": "k1",
                "text": "Recall is stronger when reviews are separated in time.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c1",
                    "start": 12,
                    "end": 70,
                    "quote": "spaced repetition"
                  }
                ]
              },
              {
                "id": "k2",
                "text": "Effortful retrieval is what consolidates a memory.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c2",
                    "start": 4,
                    "end": 58,
                    "quote": "spaced repetition"
                  }
                ]
              },
              {
                "id": "k3",
                "text": "Cramming feels productive because fluency is mistaken for learning.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c2",
                    "start": 61,
                    "end": 130,
                    "quote": "spaced repetition"
                  }
                ]
              },
              {
                "id": "k4",
                "text": "A first review within a day catches most of the forgetting curve.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c3",
                    "start": 0,
                    "end": 62,
                    "quote": "spaced repetition"
                  }
                ]
              },
              {
                "id": "k5",
                "text": "Intervals can widen once recall becomes reliable.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c3",
                    "start": 65,
                    "end": 118,
                    "quote": "spaced repetition"
                  }
                ]
              }
            ],
            "important_details": [
              {
                "id": "d1",
                "text": "The effect holds across ages and subject matter.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c4",
                    "start": 0,
                    "end": 47,
                    "quote": "spaced repetition"
                  }
                ]
              },
              {
                "id": "d2",
                "text": "Sleep between sessions appears to matter more than total hours.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c4",
                    "start": 50,
                    "end": 118,
                    "quote": "spaced repetition"
                  }
                ]
              },
              {
                "id": "d3",
                "text": "Self-testing outperforms re-reading at equal time cost.",
                "provenance": "ai",
                "source_refs": [
                  {
                    "chunk_id": "c5",
                    "start": 0,
                    "end": 55,
                    "quote": "spaced repetition"
                  }
                ]
              }
            ],
            "practical_actions": [
              {
                "id": "a1",
                "text": "Review new material once the next day, then after a week.",
                "provenance": "ai",
